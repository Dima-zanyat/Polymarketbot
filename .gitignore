# ==========================================
# 1. Python (Скомпилированные файлы и кэш)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ==========================================
# 2. Виртуальные окружения
# ==========================================
venv/
ENV/
env/
.venv/
.venv/bin/
.venv/lib/

# ==========================================
# 3. Переменные окружения и секреты
# ==========================================
# Критически важно! Никогда не коммитьте пароли, токены, URL брокеров
.env
.env.local
.env.*
!.env.example  # Можно коммитить шаблон переменных

# ==========================================
# 4. Тестирование и покрытие (Coverage)
# ==========================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# ==========================================
# 5. Сборка и дистрибутивы (если делаете пакет)
# ==========================================
build/
dist/
*.egg-info/
*.egg
*.whl

# ==========================================
# 6. IDE и редакторы кода
# ==========================================
# PyCharm / IntelliJ
.idea/
*.iml
*.ipr
*.iws

# VS Code
.vscode/
*.code-workspace

# Vim / Emacs
*.swp
*.swo
*~
.project
.classpath
.settings/

# ==========================================
# 7. Логи и временные файлы
# ==========================================
*.log
logs/
*.tmp
*.bak
*.swp

# ==========================================
